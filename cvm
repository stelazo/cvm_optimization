lista = function(banco){
  
  lista = as.data.frame(my_df$NOME[grep(banco, my_df$NOME)])
  lista = data.frame(NOME = c(my_df$NOME[grep(banco, my_df$NOME)]))
  
  #codigos dos bancos, coloquei manualmente
  if (banco == "BB") {
    x = "1"
    y = "0086-8"
    
  }else if (banco == "CAIXA") {
    x = "104"
    y = "4204-6"
    
  }
   #ainda n  identifiquei os codigos
  lista[c("CO_BANCO")] = x   # ok certinho 
  lista[c("CO_AGENCIA")] = y    # ok, certinho 
  
  return(lista)
}

lista_CAIXA = lista("CAIXA")  
