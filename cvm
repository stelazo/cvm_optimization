juncao = function(banco){
  
  if (banco == "BB"){
    i = length(CO_CONTA_BB$CO_CONTA)
    n = length(lista_BB$NOME)
    lista = lista_BB 
    CO_CONTA = CO_CONTA_BB
    
  }else if(banco == "CAIXA"){
    i = length(CO_CONTA_CAIXA)
    n = length(lista_CAIXA$NOME)
    lista = lista_CAIXA
    CO_CONTA = CO_CONTA_CAIXA
  }  
  
  # REPLICANDO O MY_DF
  lista_dup = do.call("rbind", replicate(i,lista, simplify = FALSE))
  
  # REPLICANDO CO_CONTA_BB E CO_CONTA_CAIXA
  CO_CONTA_dup = do.call("rbind", replicate(n,CO_CONTA, simplify = FALSE))  
  
  # JUNTANDO AS DUAS BASES PELA COLUNA NOME 
  my_base = merge(my_df, lista_dup, by.x = "NOME", by.y = "NOME")
  
  # juntando o df com os codigos das contas lado a lado
  df_final = cbind(my_base, CO_CONTA_dup)
  
  
  return(df_final)
}

